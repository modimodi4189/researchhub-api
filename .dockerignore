*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
pytest_output.txt
tests/
pytest.ini

# Local runtime state and generated artifacts
logs/
*.log
ml_artifacts/
.cache/
tmp/
*.tmp
.DS_Store

# Packaging/build output
build/
dist/
*.egg-info/
