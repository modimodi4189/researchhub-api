# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchhub

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres password (used by docker-compose)
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# App Settings
APP_NAME=ResearchHub API
DEBUG=False
CORS_ORIGINS=["http://localhost:3000"]
FAISS_INDEX_DIR=ml_artifacts
