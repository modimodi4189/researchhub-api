# Local development defaults only. Do not use these values in production.

# Database
# Required by Docker Compose. Generate a local value; do not reuse it in production.
POSTGRES_PASSWORD=

# Used when running the API directly on the host. Replace <postgres-password>
# with POSTGRES_PASSWORD. Docker Compose overrides this with the internal
# postgres service URL.
DATABASE_URL=postgresql+asyncpg://postgres:<postgres-password>@localhost:5432/researchhub

# JWT - required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# App Settings
APP_NAME=ResearchHub API
DEBUG=False
# Use explicit origins in deployed environments. "*" is only allowed with DEBUG=True.
CORS_ORIGINS=["http://localhost:3000"]
FAISS_INDEX_DIR=ml_artifacts
